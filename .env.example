# 复制为 .env.local 后填写；请不要将真实密钥提交到 Git。
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_ANON_KEY=your-anon-key

# 仅服务端文章管理与上传接口使用，绝不能以 NEXT_PUBLIC_ 前缀暴露。
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 后台登录配置：请使用长度足够且唯一的随机值，不能提交真实值。
BLOG_ADMIN_PASSWORD=change-to-a-strong-password
BLOG_AUTH_SECRET=change-to-a-long-random-secret
